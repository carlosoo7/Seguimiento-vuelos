# Copia este archivo a .env y rellena lo que uses.

# --- Travelpayouts / Aviasales (recomendado: gratis, 1 llamada = 1 mes de precios por ruta) ---
# Regístrate en https://www.travelpayouts.com -> Herramientas -> API -> token
TRAVELPAYOUTS_TOKEN=

# --- Amadeus Self-Service (gratis con cuota mensual; "test" devuelve datos limitados) ---
# https://developers.amadeus.com -> My Self-Service Workspace -> crea app
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# --- Telegram (opcional, para avisos en modo watch) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
